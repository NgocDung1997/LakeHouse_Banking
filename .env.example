# Template for .env — copy it and fill in your own values:
#   Copy-Item .env.example .env
# Never commit .env.

# ── Credentials ───────────────────────────────────────────────────────────────
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-min-8-chars

# Must NOT start with "pg_" — that prefix is reserved by Postgres (initdb refuses it)
POSTGRES_USER=lab_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lab_db
# One database per layer (same Postgres server) for the Iceberg REST JDBC catalog registry
# (iceberg_tables, iceberg_namespace_properties), apart from the banking source data.
ICEBERG_BRONZE_CATALOG_DB=iceberg_catalog_bronze
ICEBERG_SILVER_CATALOG_DB=iceberg_catalog_silver

# ── Storage ───────────────────────────────────────────────────────────────────
# Bucket for Iceberg tables (B5)
MINIO_BUCKET=lakehouse
# Bucket for Parquet, CSV, JSON files from notebooks and Spark jobs (B3–B4)
MINIO_LAB_BUCKET=lab
MINIO_ENDPOINT=http://minio-dungafk:9000

# ── Iceberg Catalog ───────────────────────────────────────────────────────────
ICEBERG_BRONZE_CATALOG_URI=http://iceberg-rest-bronze-dungafk:8181
ICEBERG_SILVER_CATALOG_URI=http://iceberg-rest-silver-dungafk:8181

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER_URL=spark://spark-master-dungafk:7077
# Memory the worker advertises to the Spark master for executors
SPARK_WORKER_MEM=2g
SPARK_WORKER_CORES=2
# Hard container limit = SPARK_WORKER_MEM + ~1g for the worker JVM
SPARK_WORKER_MEM_LIMIT=3g

# ── Trino ─────────────────────────────────────────────────────────────────────
# Hard container limit, must be larger than -Xmx in conf/trino/jvm.config
TRINO_MEM_LIMIT=1200m
# Trino runs without authentication (plain HTTP on host port 8086, any user name).

# ── AWS / MinIO region ────────────────────────────────────────────────────────
# Required by iceberg-aws-bundle (SDK v2), even with MinIO.
AWS_REGION=us-east-1

# ── PII protection (silver) ───────────────────────────────────────────────────
# AES-256 key for encrypting PII columns (exactly 16, 24 or 32 characters). Changing it makes old values unreadable.
PII_ENCRYPTION_KEY=change-me-exactly-32-characters!
# Secret salt for the keyed hash of PII columns (compare / join without decrypting)
PII_HASH_KEY=change-me

# ── MySQL (LOS source database) ──────────────────────────────────────────────
# MySQL reads MYSQL_DATABASE / MYSQL_USER / MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD
# ONLY on the first start of an empty mysql_data volume.
MYSQL_HOST=mysql-dungafk
MYSQL_PORT=3306
MYSQL_DATABASE=los_db
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
