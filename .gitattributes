# Force LF line endings: most files here are mounted into Linux containers
# (Trino jvm.config, spark-defaults.conf, SQL init scripts, Python jobs),
# where a stray \r breaks parsing.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never touch
*.png binary
*.jpg binary
*.jar binary
*.parquet binary
